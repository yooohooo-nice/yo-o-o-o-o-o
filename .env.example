# ── 必填 ────────────────────────────────────────────────────────
# 访问密码（登录网页用），请用足够长的随机密码
ACCESS_PASSWORD=
# 用于签名播放链接、加密 IP，生成方法：openssl rand -hex 32
APP_SECRET=
# 随便填一个名字即可（Kimi 平台遗留的变量）
APP_ID=liuguang

# ── docker compose 部署时使用 ───────────────────────────────────
# 要启用的可选服务，逗号分隔：
#   caddy        公网服务器 + 域名时启用（自动 HTTPS）；用 Tailscale 时不要加
#   flaresolverr 自动通过 Cloudflare 验证，需要多约 500MB 内存（建议 2 核 4G）
COMPOSE_PROFILES=caddy,flaresolverr
# 数据库密码，随便设一个长随机串：openssl rand -hex 16
DB_PASSWORD=
# 用 Caddy 自动 HTTPS 时填写你的域名，例如 play.example.com
DOMAIN=

# ── 不用 docker compose、自己装 MySQL 时才需要 ───────────────────
# DATABASE_URL=mysql://user:pass@127.0.0.1:3306/liuguang

# ── 可选 ────────────────────────────────────────────────────────
# 前面有反向代理（Caddy / Nginx / Tailscale serve）时设为 1；docker compose 已自动设置
# TRUST_PROXY=1
# 只有在内网/VPN 内用纯 http:// 访问、没有 HTTPS 时才设为 false，否则无法登录
# COOKIE_SECURE=false
# ── 我的 PikPak（可选）────────────────────────────────────────────
# 填写后页面顶部「我的 PikPak」可以浏览、播放网盘文件，并把磁力链接交给 PikPak 离线下载。
# 只写在服务器的 .env 里，不要提交到仓库或发给别人。
# PIKPAK_USERNAME=
# PIKPAK_PASSWORD=

# ── BT 与格式转换（media 服务）────────────────────────────────────
# 关闭 BT 功能（磁力链接 / 种子）：改成 false
# BT_ENABLED=true
# BT 上传限速（KB/s）。BT 下载时一定会同时上传给别人，这里限制上传速度
# BT_UPLOAD_LIMIT_KB=200
# 临时文件（BT 下载的数据、转换后的视频）最多占用多少 GB，超出会自动删除最旧的
# MEDIA_MAX_GB=8
# BT 任务多久没人看就删除（分钟）
# TORRENT_IDLE_MIN=30

# 不用 docker compose 时，如果单独运行了 fetcher/，在这里填它的地址
# FETCHER_URL=http://127.0.0.1:8080/fetch
